# Copy to .env.local for local development.
# In production, leave unset — all URLs default to the current origin.

# Base URL for HTTP API calls (e.g. http://localhost:4000 for local dev)
VITE_API_URL=http://localhost:4000

# WebSocket base URL (e.g. ws://localhost:4000/poker for local dev)
VITE_WS_URL=ws://localhost:4000/poker

# Prefix for /api/* routes (default: /api)
VITE_API_BASE_URL=http://localhost:4000/api
